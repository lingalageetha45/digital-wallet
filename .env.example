# Application
APP_NAME=Digital Wallet API
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://wallet_user:wallet_pass@localhost:5432/digital_wallet
DATABASE_URL_SYNC=postgresql://wallet_user:wallet_pass@localhost:5432/digital_wallet

# Security
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# Celery (optional)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Transaction Limits (defaults)
MAX_TRANSACTION_AMOUNT=100000.00
DAILY_TRANSFER_LIMIT=50000.00
DAILY_WITHDRAWAL_LIMIT=20000.00
MAX_TRANSACTIONS_PER_DAY=50
SUSPICIOUS_AMOUNT_THRESHOLD=10000.00

# First Super Admin (created on startup if not exists)
FIRST_SUPERUSER_EMAIL=admin@wallet.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-unique-strong-password
FIRST_SUPERUSER_FULL_NAME=System Administrator

# PostgreSQL container password (must match the credentials in DATABASE_URL)
POSTGRES_PASSWORD=replace-with-a-strong-database-password
